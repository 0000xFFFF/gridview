{
  "name": "gridview",
  "version": "1.2.0",
  "description": "masonry grid layout image viewer",
  "author": "0000xFFFF",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . gridview --overwrite --platform=linux --arch=x64 --out=release-builds --icon=assets/icon.png"
  },
  "build": {
    "appId": "com.0000xFFFF.gridview",
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@electron/packager": "20.0.1",
    "electron": "42.4.0"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "image-size": "2.0.2"
  }
}
