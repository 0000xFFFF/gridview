[Desktop Entry]
Version=1.0
Type=Application
Name=GridView
Comment=Image and video viewer
Exec=gridview %F
Icon=gridview
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/webp;image/tiff;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-m4v;video/x-ms-wmv;video/x-flv;video/mpeg;video/mp2t;video/3gpp;
StartupNotify=true
